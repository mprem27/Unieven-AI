resolver 127.0.0.11 valid=10s ipv6=off;
upstream campus_api {
    zone campus_api 64k;
    least_conn;
    server campus:4100 resolve;
    keepalive 32;
}
server {
    listen 80;
    server_name ${CAMPUS_SERVER_NAME};
    return 301 https://${CAMPUS_SERVER_NAME}$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${CAMPUS_SERVER_NAME};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;
    client_max_body_size 26m;
    client_body_timeout 30s;
    send_timeout 60s;
    # No query strings, cookies, request bodies or upstream tokens in access logs.
    access_log off;
    location ^~ /api/v1/ { return 404; }
    location / {
        proxy_pass http://campus_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite user-supplied forwarding headers at this sole trusted edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 60s;
        # Never replay a POST/login/upload after an upstream failure.
        proxy_next_upstream off;
    }
}
