{
  "name": "veltech-ams-mini-android",
  "version": "2.3.3",
  "private": true,
  "description": "Pinned Bubblewrap tools for the Veltech AMS mini Trusted Web Activity",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "node ../scripts/android-prepare.mjs --dry-run",
    "prepare:app": "node ../scripts/android-prepare.mjs",
    "assetlinks": "node ../scripts/android-assetlinks.mjs",
    "build:release": "node ../scripts/android-build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bubblewrap/cli": "1.27.0",
    "@bubblewrap/core": "1.27.0"
  }
}
