# COPY ONLY these entries into .private/campus.env; keep existing keys/Atlas URI.
# In a hosting dashboard, add each entry to the CAMPUS BACKEND service's secrets.
CAMPUS_PUBLIC_URL="https://campus.your-domain.edu"
CAMPUS_MAIL_FROM="veltech-ams-mini <your-sender@gmail.com>"
CAMPUS_MAIL_REPLY_TO="your-sender@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_REQUIRE_TLS="true"
SMTP_USER="your-sender@gmail.com"
SMTP_PASS="REPLACE_WITH_GOOGLE_APP_PASSWORD"
# Port 587 alternative: SMTP_PORT="587", SMTP_SECURE="false", SMTP_REQUIRE_TLS="true".
# Use a provider-issued app password/SMTP key, never a student's AMS password.
